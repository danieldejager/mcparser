{
  "name": "mcparser-ui",
  "productName": "McParser",
  "license": "LicenseRef-McParser-NonCommercial",
  "version": "0.3.0",
  "private": true,
  "description": "McParser desktop UI.",
  "main": "main.js",
  "scripts": {
    "start": "node rename-mac.js && electron .",
    "dist": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux deb"
  },
  "devDependencies": {
    "electron": "36.4.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.danieldejager.mcparser",
    "productName": "McParser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "studio.css",
      "rename-mac.js",
      "hunts.js",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "../target/release",
        "to": ".",
        "filter": [
          "mcparser",
          "mcparser.exe"
        ]
      }
    ],
    "mac": {
      "identity": null,
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "icon": "icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Development",
      "maintainer": "Daniel de Jager <danieldejager@users.noreply.github.com>",
      "icon": "icon.png"
    },
    "icon": "icon.png"
  },
  "homepage": "https://github.com/danieldejager/mcparser",
  "author": {
    "name": "Daniel de Jager",
    "email": "danieldejager@users.noreply.github.com"
  }
}
